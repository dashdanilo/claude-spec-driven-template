# Personal Claude Code files (do not share)
# .claude/agent-memory/ (memory: project subagents) is NOT here on purpose:
# it is versioned and reviewed with the PR like any other file. Only
# memory: local subagents write to .claude/agent-memory-local/, which stays
# personal.
CLAUDE.local.md
.claude/settings.local.json
.claude/agent-memory-local/
.claude/agent-log.txt
.claude/.agent-log-consumed

# Generated context (Repomix snapshot, etc)
# The folder itself has a local .gitignore that keeps README.md and .gitignore
.claude/context/repomix-snapshot.md
.claude/context/last-analyze.log
.claude/context/config.json

# Claude Code session state
.claude/projects/
.claude/shell-snapshots/
.claude/backups/

# Dependencies
node_modules/
.pnpm-store/

# Build outputs
.next/
dist/
build/
out/

# Logs
*.log
.DS_Store

# Environment
.env
.env.local
.env.*.local

# Coverage
coverage/
.nyc_output/
.claude/tool-log.txt
