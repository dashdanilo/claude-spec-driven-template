# Personal Claude Code files (do not share)
# Adopting repos version .claude/agent-memory/ (memory: project) on purpose.
# THIS repo is public, and the agents that run here write notes about the
# private repos they were dispatched against, so here it stays out of git.
.claude/agent-memory/
CLAUDE.local.md
.claude/settings.local.json
.claude/agent-memory-local/
.claude/agent-log.txt
.claude/.agent-log-consumed
.claude/verification/
.claude/handovers/

# Generated context (Repomix snapshot, etc)
# The folder itself has a local .gitignore that keeps README.md and .gitignore
.claude/context/repomix-snapshot.md
.claude/context/last-analyze.log
.claude/context/config.json

# Claude Code session state
.claude/projects/
.claude/shell-snapshots/
.claude/backups/

# Dependencies
node_modules/
.pnpm-store/

# Build outputs
.next/
dist/
build/
out/

# Python bytecode cache (baseline/hooks/lib/bash-write-targets.py is loaded
# via importlib by log-edit.sh, which writes this next to the source on
# every run; it differs by interpreter version, so a machine running a
# different python3 than whoever last wrote it would otherwise see it as an
# uncommitted change under baseline/ on every session)
__pycache__/
*.pyc

# Logs
*.log
.DS_Store

# Environment
.env
.env.local
.env.*.local

# Coverage
coverage/
.nyc_output/
.claude/tool-log.txt

# harness-score local reports (CI generates these fresh every run, at the
# repo root only -- anchored so this does not shadow docs/guides/harness-score.md)
/harness-score.json
/harness-score.md
